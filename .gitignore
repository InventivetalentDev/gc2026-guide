# Deploy staging directory. Rebuilt from the repo root by tools/build-site.sh
# on every deploy — never edit anything in here.
dist/

# Wrangler's local state and scratch files.
.wrangler/

# Local Worker dependencies and secrets. The example file is safe to commit.
node_modules/
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*

# Python bytecode from running the tools in tools/.
__pycache__/
